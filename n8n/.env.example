# ============================================================================
# n8n Environment Configuration for Mamba Training Pipeline
# ============================================================================
# Copy this file to .env and customize for your environment
# ============================================================================

# n8n Database Password (CHANGE THIS!)
N8N_DB_PASSWORD=mamba_n8n_db_secure_password

# n8n Admin Credentials (CHANGE THIS!)
N8N_USER=admin
N8N_PASSWORD=mamba_admin_password

# n8n Host Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone
TIMEZONE=UTC

# ============================================================================
# Mamba Workspace Configuration
# ============================================================================

# Path to Mamba workspace on host
MAMBA_WORKSPACE_PATH=/home/rohan/Main mamba statefull

# EODHD API Key file (optional)
# EODHD_KEY_FILE=/path/to/.eodhd_api_key

# ============================================================================
# Training Pipeline Defaults
# ============================================================================

# Default symbols for training (comma-separated)
DEFAULT_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,META,AMZN,TSLA,JPM,V,UNH

# Default horizon
DEFAULT_HORIZON=63

# Walk-forward window
WF_START=2010-07-02
WF_END=2025-07-01
WF_TRAIN_YEARS=5
WF_STEP_DAYS=126

# Optuna settings
OPTUNA_TRIALS=100
OPTUNA_TIMEOUT_HOURS=24

# ============================================================================
# Notifications (optional)
# ============================================================================

# Slack webhook for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Email (SMTP) settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=alerts@yourcompany.com
