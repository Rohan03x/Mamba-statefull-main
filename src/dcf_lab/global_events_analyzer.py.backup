                current_date += timedelta(days=1)
            
            return events
            
        except Exception as e:
            logger.warning(f"Error generating mock GDELT events: {e}")
            return []
    
    def analyze_event_sentiment(self, events: List[GlobalEvent]) -> Dict[str, Any]:
        """
        Analyze sentiment patterns across events
        
        Args:
            events: List of GlobalEvent objects
            
        Returns:
            Dictionary with sentiment analysis results
        """
        try:
            if not events:
                return {}
            
            # Calculate aggregate metrics
            total_mentions = sum(e.num_mentions for e in events)
            avg_goldstein = np.mean([e.goldstein_scale for e in events])
            avg_tone = np.mean([e.avg_tone for e in events])
            
            # Sentiment distribution
            tone_scores = [e.avg_tone for e in events]
            sentiment_distribution = {
                'very_negative': len([t for t in tone_scores if t <= self.tone_thresholds['very_negative']]),
                'negative': len([t for t in tone_scores if self.tone_thresholds['very_negative'] < t <= self.tone_thresholds['negative']]),
                'neutral': len([t for t in tone_scores if self.tone_thresholds['negative'] < t <= self.tone_thresholds['positive']]),
                'positive': len([t for t in tone_scores if self.tone_thresholds['positive'] < t <= self.tone_thresholds['very_positive']]),
                'very_positive': len([t for t in tone_scores if t > self.tone_thresholds['very_positive']])
            }
            
            # Event type analysis
            event_type_counts = defaultdict(int)
            event_type_sentiment = defaultdict(list)
            
            for event in events:
                event_type_counts[event.event_type] += 1
                event_type_sentiment[event.event_type].append(event.avg_tone)
            
            # Regional analysis
            regional_sentiment = defaultdict(list)
            for event in events:
                regional_sentiment[event.location].append(event.avg_tone)
            
            analysis = {
                'summary': {
                    'total_events': len(events),
                    'total_mentions': total_mentions,
                    'avg_goldstein_scale': avg_goldstein,
                    'avg_tone': avg_tone,
                    'sentiment_trend': self._classify_sentiment(avg_tone)
                },
                'sentiment_distribution': sentiment_distribution,
                'event_types': {
                    event_type: {
                        'count': count,
                        'avg_sentiment': np.mean(event_type_sentiment[event_type])
                    }
                    for event_type, count in event_type_counts.items()
                },
                'regional_sentiment': {
                    region: np.mean(sentiments)
                    for region, sentiments in regional_sentiment.items()
                }
            }
            
            return analysis
            
        except Exception as e:
            logger.error(f"Error analyzing event sentiment: {e}")
            return {}
    
    def detect_regime_changes(self, events: List[GlobalEvent],
                             lookback_window: int = 30) -> List[EventSignal]:
        """
        Detect potential regime changes from event patterns
        
        Args:
            events: List of GlobalEvent objects
            lookback_window: Days to look back for trend analysis
            
        Returns:
            List of EventSignal objects for regime changes
        """
        try:
            logger.info("🔍 Detecting regime changes from global events")
            
            if len(events) < lookback_window:
                logger.warning("Insufficient event data for regime change detection")
                return []
            
            signals = []
            
            # Sort events by date
            events_sorted = sorted(events, key=lambda x: x.event_date)
            
            # Analyze recent vs historical patterns
            recent_events = events_sorted[-lookback_window:]
            historical_events = events_sorted[:-lookback_window] if len(events_sorted) > lookback_window else []
            
            # Calculate recent vs historical sentiment
            recent_avg_tone = np.mean([e.avg_tone for e in recent_events])
            recent_avg_goldstein = np.mean([e.goldstein_scale for e in recent_events])
            
            if historical_events:
                historical_avg_tone = np.mean([e.avg_tone for e in historical_events])
                historical_avg_goldstein = np.mean([e.goldstein_scale for e in historical_events])
                
                # Detect significant shifts
                tone_shift = recent_avg_tone - historical_avg_tone
                goldstein_shift = recent_avg_goldstein - historical_avg_goldstein
                
                # Generate regime change signals
                if abs(tone_shift) > 20.0 or abs(goldstein_shift) > 3.0:
                    signal_type = "regime_change"
                    if tone_shift < -20.0 or goldstein_shift < -3.0:
                        signal_category = "deterioration"
                        sentiment_score = -0.7
                    else:
                        signal_category = "improvement"
                        sentiment_score = 0.7
                    
                    # Determine affected regions
                    regions_set = {e.location for e in recent_events}
                    affected_regions = list(regions_set)
                    
                    signal = EventSignal(
                        signal_date=recent_events[-1].event_date,
                        signal_type=signal_type,
                        event_category=signal_category,
                        affected_regions=affected_regions,
                        sentiment_score=sentiment_score,
                        magnitude=min(abs(tone_shift) / 50.0, 1.0),
                        confidence=0.8,
                        description=f"Detected {signal_category} in global sentiment",
                        related_events=[e.event_id for e in recent_events[-5:]]
                    )
                    signals.append(signal)
            
            # Detect crisis patterns
            crisis_signals = self._detect_crisis_patterns(recent_events)
            signals.extend(crisis_signals)
            
            logger.info(f"🚨 Detected {len(signals)} regime change signals")
            return signals
            
        except Exception as e:
            logger.error(f"Error detecting regime changes: {e}")
            return []
    
    def _detect_crisis_patterns(
            self, events: List[GlobalEvent]) -> List[EventSignal]:
        """Detect crisis patterns in recent events"""
        try:
            signals = []

            # High-conflict events
            extreme_neg = self.goldstein_thresholds['extreme_negative']
            conflict_events = [e for e in events
                               if e.goldstein_scale <= extreme_neg]

            if len(conflict_events) >= 3:  # Multiple high-conflict events
                conflict_regions = {e.location for e in conflict_events}
                signal = EventSignal(
                    signal_date=events[-1].event_date,
                    signal_type="crisis_risk",
                    event_category="geopolitical",
                    affected_regions=list(conflict_regions),
                    sentiment_score=-0.8,
                    magnitude=min(len(conflict_events) / 10.0, 1.0),
                    confidence=0.9,
                    description="Multiple high-conflict events detected",
                    related_events=[e.event_id for e in conflict_events]
                )
                signals.append(signal)

            # Economic crisis pattern
            economic_events = [e for e in events
                               if 'ECONOMIC' in e.event_type and
                               e.avg_tone < -30.0]

            if len(economic_events) >= 2:
                economic_regions = {e.location for e in economic_events}
                signal = EventSignal(
                    signal_date=events[-1].event_date,
                    signal_type="crisis_risk",
                    event_category="economic",
                    affected_regions=list(economic_regions),
                    sentiment_score=-0.7,
                    magnitude=min(len(economic_events) / 5.0, 1.0),
                    confidence=0.8,
                    description="Economic crisis pattern detected",
                    related_events=[e.event_id for e in economic_events]
                )
                signals.append(signal)

            return signals

        except Exception as e:
            logger.warning(f"Error detecting crisis patterns: {e}")
            return []
    
    def get_corporate_event_mentions(self, ticker: str,
                                     end_date: str) -> CorporateEventMentions:
        """
        Get corporate mentions in global events
        
        Args:
            ticker: Stock ticker symbol
            start_date: Start date in YYYY-MM-DD format
            end_date: End date in YYYY-MM-DD format
            
        Returns:
            CorporateEventMentions object
        """
        try:
            logger.info(f"🏢 Analyzing corporate event mentions for {ticker}")
            
            # For demonstration, generate mock corporate mention data
            # In production, this would query GDELT GKG for entity mentions
            
            end_dt = datetime.strptime(end_date, '%Y-%m-%d')
            
            # Mock data based on ticker
            mention_data = {
                'AAPL': {
                    'mention_count': 45,
                    'avg_sentiment': 15.2,
                    'event_types': ['ECONOMIC_POLICY', 'TRADE_AGREEMENT'],
                    'geographic_exposure': {'USA': 0.6, 'CHN': 0.3, 'EU': 0.1}
                },
                'TSLA': {
                    'mention_count': 67,
                    'avg_sentiment': 8.7,
                    'event_types': ['ECONOMIC_POLICY', 'ENVIRONMENTAL'],
                    'geographic_exposure': {'USA': 0.7, 'CHN': 0.2, 'EU': 0.1}
                }
            }
            
            data = mention_data.get(ticker, {
                'mention_count': 12,
                'avg_sentiment': 2.1,
                'event_types': ['ECONOMIC_POLICY'],
                'geographic_exposure': {'USA': 0.8, 'Global': 0.2}
            })
            
            mentions = CorporateEventMentions(
                ticker=ticker,
                mention_date=end_dt.strftime('%Y-%m-%d'),
                mention_count=data['mention_count'],
                avg_sentiment=data['avg_sentiment'],
                event_types=data['event_types'],
                geographic_exposure=data['geographic_exposure']
            )
            
            logger.info(f"📰 Found {mentions.mention_count} mentions with {mentions.avg_sentiment:.1f} avg sentiment")
            return mentions
            
        except Exception as e:
            logger.error(f"Error getting corporate event mentions: {e}")
            return CorporateEventMentions(
                ticker=ticker,
                mention_date=end_date,
                mention_count=0,
                avg_sentiment=0.0,
                event_types=[],
                geographic_exposure={}
            )
    
    def get_global_events_features(self, start_date: str, end_date: str,
                                  ticker: Optional[str] = None) -> Dict[str, float]:
        """
        Generate global events features for ML models
        
        Args:
            start_date: Start date for analysis
            end_date: End date for analysis
            ticker: Optional ticker for corporate-specific features
            
        Returns:
            Dictionary of global events features
        """
        try:
            features = {}
            
            # Get global events
            events = self.get_global_events(start_date, end_date)
            
            if not events:
                return {}
            
            # Basic event metrics
            features['event_count'] = len(events)
            features['total_mentions'] = sum(e.num_mentions for e in events)
            features['avg_goldstein_scale'] = np.mean([e.goldstein_scale for e in events])
            features['avg_tone'] = np.mean([e.avg_tone for e in events])
            
            # Sentiment analysis
            sentiment_analysis = self.analyze_event_sentiment(events)
            if sentiment_analysis:
                summary = sentiment_analysis.get('summary', {})
                features['sentiment_trend_score'] = self._sentiment_to_score(
                    summary.get('sentiment_trend', 'neutral'))
                
                # Sentiment distribution features
                dist = sentiment_analysis.get('sentiment_distribution', {})
                total_events = sum(dist.values()) if dist.values() else 1
                features['negative_event_ratio'] = (
                    (dist.get('very_negative', 0) + dist.get('negative', 0)) / total_events)
                features['positive_event_ratio'] = (
                    (dist.get('positive', 0) + dist.get('very_positive', 0)) / total_events)
            
            # Regime change signals
            regime_signals = self.detect_regime_changes(events)
            features['regime_change_signals'] = len(regime_signals)
            features['max_signal_magnitude'] = max([s.magnitude for s in regime_signals], default=0.0)
            features['crisis_risk_signals'] = len([s for s in regime_signals if s.signal_type == 'crisis_risk'])
            
            # Corporate-specific features
            if ticker:
                mentions = self.get_corporate_event_mentions(ticker, end_date)
                features['corporate_mentions'] = mentions.mention_count
                features['corporate_sentiment'] = mentions.avg_sentiment / 100.0  # Normalize to [-1, 1]
                features['geographic_risk_exposure'] = max(mentions.geographic_exposure.values(), default=0.0)
            
            logger.info(f"📊 Generated {len(features)} global events features")
            return features
            
        except Exception as e:
            logger.error(f"Error generating global events features: {e}")
            return {}
    
    def _classify_sentiment(self, avg_tone: float) -> str:
        """Classify sentiment based on average tone"""
        if avg_tone <= self.tone_thresholds['very_negative']:
            return 'very_negative'
        elif avg_tone <= self.tone_thresholds['negative']:
            return 'negative'
        elif avg_tone <= self.tone_thresholds['positive']:
            return 'neutral'
        elif avg_tone <= self.tone_thresholds['very_positive']:
            return 'positive'
        else:
            return 'very_positive'
    
    def _sentiment_to_score(self, sentiment: str) -> float:
        """Convert sentiment classification to numerical score"""
        sentiment_scores = {
            'very_negative': -1.0,
            'negative': -0.5,
            'neutral': 0.0,
            'positive': 0.5,
            'very_positive': 1.0
        }
        return sentiment_scores.get(sentiment, 0.0)