"""
GDELT Global Events Analysis Pipeline

This module implements global event tracking and sentiment analysis using GDELT
(Global Database of Events, Language, and Tone) data to detect regime changes
and generate event-driven trading signals.

Key Features:
- Process GDELT news mentions and event data
- Calculate event sentiment and volume metrics
- Detect geopolitical and economic regime changes
- Generate event-driven market signals
- Track corporate mention patterns

Data Sources:
- GDELT Event Database (political events)
- GDELT Global Knowledge Graph (entity mentions)
- GDELT News API (sentiment and tone)
- Country-specific event filtering
"""

import logging
import requests
import numpy as np
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any
from dataclasses import dataclass
from collections import defaultdict

logger = logging.getLogger(__name__)


@dataclass
class GlobalEvent:
    """Represents a global event from GDELT"""
    event_id: str
    event_date: str
    event_type: str  # Conflict, Economic, Political, etc.
    actors: List[str]  # Countries/entities involved
    location: str
    goldstein_scale: float  # -10 to +10 conflict/cooperation scale
    num_mentions: int
    avg_tone: float  # -100 to +100 sentiment
    source_url: Optional[str] = None
    
    
@dataclass
class EventSignal:
    """Event-driven trading signal"""
    signal_date: str
    signal_type: str  # regime_change, crisis_risk, stability_signal
    event_category: str  # geopolitical, economic, social
    affected_regions: List[str]
    sentiment_score: float  # -1 to +1
    magnitude: float  # 0 to 1 impact magnitude
    confidence: float  # 0 to 1 signal confidence
    description: str
    related_events: List[str]


@dataclass
class CorporateEventMentions:
    """Corporate mentions in global events"""
    ticker: str
    mention_date: str
    mention_count: int
    avg_sentiment: float
    event_types: List[str]
    geographic_exposure: Dict[str, float]  # Region -> exposure weight
    

class GlobalEventsAnalyzer:
    """
    GDELT Global Events Analysis System
    
    Analyzes global events, news sentiment, and geopolitical developments
    to generate regime change signals and event-driven trading insights.
    """
    
    def __init__(self, gdelt_api_key: Optional[str] = None):
        self.gdelt_api_key = gdelt_api_key
        
        # GDELT API endpoints (V2 for free tier access)
        self.gdelt_base_url = "https://api.gdeltproject.org/api/v2"
        self.gdelt_doc_url = f"{self.gdelt_base_url}/doc/doc"
        self.gdelt_tv_url = f"{self.gdelt_base_url}/tv/tv"
        self.gdelt_gkg_url = f"{self.gdelt_base_url}/gkg/gkg"
        
        # Alternative: GDELT Real-time Event API (15-minute updates)
        self.gdelt_realtime_url = "http://data.gdeltproject.org/gdeltv2/lastupdate.txt"
        self.gdelt_events_url = "http://data.gdeltproject.org/gdeltv2"
        
        self.session = requests.Session()
        self.session.headers.update({
            'User-Agent': 'DCF Lab Research Tool/1.0 (research@dcflab.com)',
            'Accept': 'application/json'
        })
        
        # Rate limiting for free tier
        self.last_request_time = None
        self.min_request_interval = 1.0  # 1 second between requests
        
        # Event type mappings
        self.event_categories = {
            'CONFLICT': ['WAR', 'PROTEST', 'VIOLENCE', 'MILITARY', 'ATTACK'],
            'ECONOMIC': ['TRADE', 'SANCTIONS', 'ECONOMIC', 'FINANCIAL', 'MARKET'],
            'POLITICAL': ['ELECTION', 'GOVERNMENT', 'POLICY', 'DIPLOMATIC', 'TREATY'],
            'SOCIAL': ['SOCIAL', 'CULTURAL', 'RELIGIOUS', 'ETHNIC', 'MIGRATION'],
            'ENVIRONMENTAL': ['CLIMATE', 'DISASTER', 'ENVIRONMENT', 'WEATHER'],
            'TECHNOLOGY': ['CYBER', 'TECHNOLOGY', 'INNOVATION', 'DIGITAL']
        }
        
        # Country/region importance weights for market impact
        self.region_market_weights = {
            'US': 0.25, 'CHINA': 0.20, 'EUROPE': 0.18, 'JAPAN': 0.08,
            'UK': 0.06, 'GERMANY': 0.05, 'FRANCE': 0.04, 'CANADA': 0.03,
            'AUSTRALIA': 0.02, 'SOUTH_KOREA': 0.02, 'INDIA': 0.02,
            'BRAZIL': 0.02, 'RUSSIA': 0.02, 'OTHER': 0.01
        }
        
        # Cache for recent data
        self._cache = {}
        self._cache_expiry = {}
        
        logger.info("GlobalEventsAnalyzer initialized with enhanced GDELT 2.0 integration")
        
        # Goldstein scale thresholds for signal generation
        self.goldstein_thresholds = {
            'extreme_negative': -8.0,  # Major conflict/crisis
            'high_negative': -5.0,     # Significant tension
            'moderate_negative': -2.0,  # Minor negative
            'neutral': 0.0,
            'moderate_positive': 2.0,   # Minor cooperation
            'high_positive': 5.0,      # Significant cooperation
            'extreme_positive': 8.0    # Major cooperation
        }
        
        # Tone thresholds for sentiment analysis
        self.tone_thresholds = {
            'very_negative': -50.0,
            'negative': -20.0,
            'neutral': 0.0,
            'positive': 20.0,
            'very_positive': 50.0
        }
    
    def get_global_events(self, start_date: str, end_date: str,
                          countries: Optional[List[str]] = None,
                          event_types: Optional[List[str]] = None
                          ) -> List[GlobalEvent]:
        """
        Retrieve global events from GDELT database
        
        Args:
            start_date: Start date in YYYY-MM-DD format
            end_date: End date in YYYY-MM-DD format
            countries: List of country codes to filter (optional)
            event_types: List of event types to filter (optional)
            
        Returns:
            List of GlobalEvent objects
        """
        try:
            msg = f"🌍 Fetching global events from {start_date} to {end_date}"
            logger.info(msg)

            # Try real GDELT API first, fallback to enhanced mock
            events = self._fetch_real_gdelt_events(start_date, end_date, countries)
            
            if not events:
                # Enhanced mock with more realistic patterns
                events = self._get_enhanced_mock_events(start_date, end_date, countries)

            # Filter by event types if specified
            if event_types:
                events = [e for e in events if any(
                    event_type.upper() in e.event_type.upper()
                    for event_type in event_types)]

            logger.info(f"📊 Retrieved {len(events)} global events")
            return events

        except Exception as e:
            logger.error(f"❌ Error fetching global events: {e}")
            return []

    def _fetch_real_gdelt_events(self, start_date: str, end_date: str,
                                countries: Optional[List[str]] = None) -> List[GlobalEvent]:
        """
        Fetch real GDELT events using the DOC API (free tier)
        
        GDELT DOC API provides news articles with location, sentiment, and themes
        which we can process into events.
        """
        events = []
        
        try:
            # Rate limiting
            self._enforce_rate_limit()
            
            # Prepare query for GDELT DOC API
            query_terms = ["market", "economic", "trade", "policy", "conflict", "cooperation"]
            
            for query in query_terms[:3]:  # Limit queries for free tier
                params = {
                    'query': query,
                    'mode': 'artlist',
                    'startdatetime': f"{start_date}T00:00:00",
                    'enddatetime': f"{end_date}T23:59:59",
                    'maxrecords': 100,  # Free tier limit
                    'format': 'json'
                }
                
                # Add country filter if specified
                if countries:
                    country_filter = " OR ".join([f"country:{c}" for c in countries[:3]])
                    params['query'] += f" AND ({country_filter})"
                
                response = self.session.get(self.gdelt_doc_url, params=params, timeout=10)
                
                if response.status_code == 200:
                    try:
                        data = response.json()
                        articles = data.get('articles', [])
                        
                        # Convert articles to events
                        for article in articles[:20]:  # Limit processing
                            event = self._article_to_event(article, query)
                            if event:
                                events.append(event)
                                
                        logger.info(f"✅ Fetched {len(articles)} articles for query '{query}'")
                        
                    except Exception as e:
                        logger.warning(f"Failed to parse GDELT response for '{query}': {e}")
                        continue
                        
                else:
                    logger.warning(f"GDELT API error {response.status_code} for '{query}'")
                    
                # Rate limiting between queries
                self._enforce_rate_limit()
                    
        except Exception as e:
            logger.warning(f"Real GDELT fetch failed: {e}, using enhanced mock")
            
        return events
    
    def _article_to_event(self, article: Dict[str, Any], query_type: str) -> Optional[GlobalEvent]:
        """Convert GDELT article to GlobalEvent object"""
        try:
            # Extract key information
            url = article.get('url', '')
            title = article.get('title', '')
            date_str = article.get('seendate', article.get('date', ''))
            
            # Parse sentiment/tone (simplified)
            tone = article.get('tone', 0.0)
            if isinstance(tone, str):
                try:
                    tone = float(tone)
                except:
                    tone = 0.0
            
            # Extract location info
            locations = article.get('locations', [])
            primary_location = locations[0] if locations else 'UNKNOWN'
            
            # Map query to event type
            event_type_mapping = {
                'market': 'ECONOMIC_MARKET',
                'economic': 'ECONOMIC_POLICY', 
                'trade': 'ECONOMIC_TRADE',
                'policy': 'POLITICAL_POLICY',
                'conflict': 'CONFLICT_TENSION',
                'cooperation': 'POLITICAL_COOPERATION'
            }
            
            event_type = event_type_mapping.get(query_type, 'GENERAL')
            
            # Generate goldstein scale from tone (-100 to +100 -> -10 to +10)
            goldstein_scale = max(-10, min(10, tone / 10))
            
            # Extract actors (simplified - countries from locations)
            actors = locations[:3] if locations else ['UNKNOWN']
            
            return GlobalEvent(
                event_id=f"gdelt_{hash(url)}_{date_str}",
                event_date=date_str[:10] if len(date_str) >= 10 else date_str,
                event_type=event_type,
                actors=actors,
                location=primary_location,
                goldstein_scale=goldstein_scale,
                num_mentions=1,  # One article = one mention
                avg_tone=tone,
                source_url=url
            )
            
        except Exception as e:
            logger.debug(f"Failed to convert article to event: {e}")
            return None
    
    def _enforce_rate_limit(self):
        """Enforce rate limiting for free API tier"""
        import time
        
        if self.last_request_time:
            elapsed = time.time() - self.last_request_time
            if elapsed < self.min_request_interval:
                time.sleep(self.min_request_interval - elapsed)
        
        self.last_request_time = time.time()

    def _get_enhanced_mock_events(
            self, start_date: str, end_date: str,
            countries: Optional[List[str]] = None) -> List[GlobalEvent]:
        """Generate enhanced mock GDELT events with realistic patterns"""
        try:
            import random
            from datetime import timedelta
            
            start_dt = datetime.strptime(start_date, '%Y-%m-%d')
            end_dt = datetime.strptime(end_date, '%Y-%m-%d')
            
            events = []
            rng = random.Random(42)  # Deterministic for testing
            
            # Enhanced event templates with realistic patterns
            event_templates = [
                {
                    'type': 'ECONOMIC_TRADE',
                    'actors': ['USA', 'CHN'],
                    'goldstein_range': (-3, 2),
                    'tone_range': (-30, 20),
                    'frequency': 0.3
                },
                {
                    'type': 'POLITICAL_COOPERATION', 
                    'actors': ['EUR', 'USA'],
                    'goldstein_range': (1, 6),
                    'tone_range': (10, 40),
                    'frequency': 0.2
                },
                {
                    'type': 'CONFLICT_TENSION',
                    'actors': ['RUS', 'UKR'],
                    'goldstein_range': (-8, -2),
                    'tone_range': (-60, -20),
                    'frequency': 0.2
                },
                {
                    'type': 'ECONOMIC_POLICY',
                    'actors': ['FED', 'USA'],
                    'goldstein_range': (-2, 3),
                    'tone_range': (-15, 25),
                    'frequency': 0.3
                }
            ]
            
            # Generate events across date range
            current_date = start_dt
            while current_date <= end_dt:
                date_str = current_date.strftime('%Y-%m-%d')
                
                # Generate 2-6 events per day
                num_events = rng.randint(2, 6)
                
                for _ in range(num_events):
                    template = rng.choice(event_templates)
                    
                    # Skip some events based on frequency
                    if rng.random() > template['frequency']:
                        continue
                    
                    goldstein = rng.uniform(*template['goldstein_range'])
                    tone = rng.uniform(*template['tone_range'])
                    mentions = rng.randint(1, 50)
                    
                    event = GlobalEvent(
                        event_id=f"mock_{current_date.timestamp()}_{rng.randint(1000, 9999)}",
                        event_date=date_str,
                        event_type=template['type'],
                        actors=template['actors'].copy(),
                        location=template['actors'][0],
                        goldstein_scale=goldstein,
                        num_mentions=mentions,
                        avg_tone=tone,
                        source_url=f"https://mock-gdelt.com/event/{date_str}"
                    )
                    
                    events.append(event)
                
                current_date += timedelta(days=1)
            
            # Add some market-specific patterns
            self._add_market_pattern_events(events, start_dt, end_dt, rng)
            
            return events
            
        except Exception as e:
            logger.error(f"Enhanced mock events generation failed: {e}")
            return []
    
    def _add_market_pattern_events(self, events: List[GlobalEvent], 
                                  start_dt: datetime, end_dt: datetime, rng):
        """Add market-specific event patterns"""
        # Add volatility clusters around weekends
        current = start_dt
        while current <= end_dt:
            if current.weekday() == 4:  # Friday
                # Higher tension events before weekends
                weekend_event = GlobalEvent(
                    event_id=f"weekend_{current.timestamp()}",
                    event_date=current.strftime('%Y-%m-%d'),
                    event_type='MARKET_VOLATILITY',
                    actors=['GLOBAL'],
                    location='GLOBAL',
                    goldstein_scale=rng.uniform(-4, -1),
                    num_mentions=rng.randint(10, 30),
                    avg_tone=rng.uniform(-35, -10),
                    source_url="https://mock-gdelt.com/weekend-effect"
                )
                events.append(weekend_event)
            
            current += timedelta(days=1)

